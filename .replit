modules = ["nodejs-24", "python-base-3.13"]

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8083
externalPort = 3000

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "artifacts/navratri: web"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "camera-browser"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pose-component"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "deployment-config"

[[workflows.workflow]]
name = "camera-browser"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:camera"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pose-component"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python -m unittest streamlit_app.test_dance_studio"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "deployment-config"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm test:deployment"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["glibcLocales"]
